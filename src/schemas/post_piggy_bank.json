{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "\\S"
    },
    "target_amount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9000000000000000
    }
  },
  "required": [
    "name",
    "target_amount"
  ],
  "additionalProperties": false
}
