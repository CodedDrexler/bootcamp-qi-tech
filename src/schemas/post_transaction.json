{
  "title": "PostTransaction",
  "type": "object",
  "properties": {
    "request_control_key": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "type": {
      "enum": ["deposit", "transfer"]
    },
    "amount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000000000
    },
    "destination_account_key": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    }
  },
  "required": [
    "request_control_key",
    "type",
    "amount"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"type": {"const": "transfer"}}
      },
      "then": {
        "required": ["destination_account_key"]
      }
    },
    {
      "if": {
        "properties": {"type": {"const": "deposit"}}
      },
      "then": {
        "not": {"required": ["destination_account_key"]}
      }
    }
  ]
}
