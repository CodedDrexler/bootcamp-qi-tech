{
  "title": "PutTransferBillingConfiguration",
  "type": "object",
  "properties": {
    "expense_type": {
      "enum": [
        "fixed_amount",
        "percentage"
      ]
    },
    "amount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000
    },
    "percentage_basis_points": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    }
  },
  "required": [
    "expense_type"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "expense_type": {
            "const": "fixed_amount"
          }
        }
      },
      "then": {
        "required": [
          "amount"
        ],
        "not": {
          "required": [
            "percentage_basis_points"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "expense_type": {
            "const": "percentage"
          }
        }
      },
      "then": {
        "required": [
          "percentage_basis_points"
        ],
        "not": {
          "required": [
            "amount"
          ]
        }
      }
    }
  ]
}
