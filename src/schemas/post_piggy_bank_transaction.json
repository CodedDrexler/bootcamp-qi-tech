{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "request_control_key": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "type": {
      "enum": [
        "reserve",
        "redeem"
      ]
    },
    "amount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000
    }
  },
  "required": [
    "request_control_key",
    "type",
    "amount"
  ],
  "additionalProperties": false
}
